---
import MainLayout from "../layouts/MainLayout.astro";
import { PAGE_DESCRIPTIONS } from "../utils/seo";
---

<MainLayout title="Get Involved" description={PAGE_DESCRIPTIONS.getInvolved}>
  <section class="upcoming">
    <div class="container">
      <h1>Get Involved</h1>
      <p>
        The best first step is joining our mailing list. We'll share local action alerts, events, and
        volunteer opportunities across Marion, Citrus, and Levy counties.
      </p>
      <p>
        <button type="button" class="button button--yellow" data-mailing-list-open>
          Join Our Mailing List
        </button>
      </p>
    </div>
  </section>
</MainLayout>
